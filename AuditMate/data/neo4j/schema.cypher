"""Neo4j schema constraints and indexes."""

CREATE CONSTRAINT IF NOT EXISTS FOR (a:Application) REQUIRE a.application_id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (s:SII) REQUIRE s.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (v:Vulnerability) REQUIRE v.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (a:AuditItem) REQUIRE a.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (p:RemediationPlan) REQUIRE p.id IS UNIQUE;

CREATE INDEX IF NOT EXISTS FOR (s:SII) ON (s.severity);
CREATE INDEX IF NOT EXISTS FOR (s:SII) ON (s.status);
CREATE INDEX IF NOT EXISTS FOR (v:Vulnerability) ON (v.severity);
CREATE INDEX IF NOT EXISTS FOR (v:Vulnerability) ON (v.status);
CREATE INDEX IF NOT EXISTS FOR (p:RemediationPlan) ON (p.status);
