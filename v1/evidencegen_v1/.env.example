# Copy this file to .env and fill in whichever values you have.
# Every value is optional — with nothing set, EvidenceGen runs fully
# end-to-end using realistic mock data and an offline rule-based
# evidence-mapping engine.

# ---- Free / low-cost LLM providers (pick ONE) ----
# Groq: https://console.groq.com — generous free tier, fast Llama models
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama: run a model fully locally and free (https://ollama.com)
# e.g. `ollama pull llama3.1 && ollama serve`
OLLAMA_HOST=
OLLAMA_MODEL=llama3.1

# ---- Real source integrations (optional) ----
GITHUB_TOKEN=
GITHUB_REPO=your-org/your-repo

CONFLUENCE_BASE_URL=https://your-domain.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# ---- App ----
PORT=5050
